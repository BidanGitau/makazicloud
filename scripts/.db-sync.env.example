# Copy to scripts/.db-sync.env and adjust values.
# scripts/.db-sync.env is gitignored — never commit production credentials.

# Production server (SSH)
PROD_SSH_HOST=169.58.137.239
PROD_SSH_USER=root
PROD_SSH_KEY=~/.ssh/makazicloud_deploy_ci
PROD_APP_DIR=/home/bidan/makazicloud

# Local PostgreSQL (pull restores here)
LOCAL_DATABASE_URL=postgresql://bidan@localhost:5432/makazicloud?schema=public

# Backup storage (relative to repo root)
BACKUP_DIR=backups
KEEP_BACKUPS=14

# Set to 1 to only download a dump without overwriting local DB
DOWNLOAD_ONLY=0

# Daily launchd schedule (install with: npm run db:sync:install-launchd)
DB_SYNC_HOUR=9
DB_SYNC_MINUTE=0
